{
  "name": "ghost-shell",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check --diagnostic-level=error . && bun run check:architecture-guardrails --silent && bun run check:code-principles --silent && bun run check:config-schema --silent && bun run check:change-policies --silent && bun run check:ghost-tokens --silent && bun run check:ci-workflow --silent && bun run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format . --diagnostic-level=error",
    "lint:biome": "biome check --diagnostic-level=error .",
    "check:ghost-tokens": "node scripts/check-ghost-tokens.mjs",
    "typecheck": "tsc -b --pretty false --force",
    "test": "node ./scripts/run-test-suite.mjs",
    "test:node": "node ./scripts/run-test-lane.mjs node",
    "test:vitest": "node ./scripts/run-test-lane.mjs vitest",
    "test:bun": "node ./scripts/run-test-lane.mjs bun",
    "build": "tsc -b --pretty false --force",
    "check:architecture-guardrails": "node ./scripts/check-architecture-guardrails.mjs",
    "check:code-principles": "node ./scripts/check-code-principles.mjs",
    "check:config-schema": "node ./scripts/check-config-schema.mjs",
    "check:change-policies": "node ./scripts/validate-change-policies.mjs",
    "dev": "bunx concurrently -n backend,plugins,shell -c blue,magenta,green \"bun run dev:backend\" \"bun run dev:plugins\" \"bun run dev:shell\"",
    "dev:shell": "bun run dev --workspace @ghost-shell/shell-app",
    "dev:backend": "bun --watch apps/backend/src/index.ts --gateway-port 41337",
    "dev:plugins": "bun apps/plugin-dev-host/src/main.ts --all --build",
    "dev:plugins:live": "bun apps/plugin-dev-host/src/main.ts --live",
    "dev:integration": "bun --watch apps/shell/src/index.ts",
    "build:plugins": "node ./scripts/build-plugins.mjs",
    "build:browser": "node ./scripts/verify-browser-builds.mjs",
    "scaffold:plugin": "node ./scripts/scaffold-plugin.mjs",
    "generate:config-schema": "node ./scripts/build-config-schemas.mjs",
    "build:dist": "node ./scripts/build-release-packages.mjs",
    "check:release-inventory": "node ./scripts/release-inventory.mjs",
    "check:release-artifacts": "node ./scripts/verify-release-artifacts.mjs",
    "check:browser-builds": "node ./scripts/verify-browser-builds.mjs",
    "check:ci-workflow": "node ./scripts/check-ci-workflow.mjs",
    "check:workspace-links": "node ./scripts/check-workspace-links.mjs",
    "repair:workspace-links": "node ./scripts/check-workspace-links.mjs --repair",
    "verify:registry-consumer": "node ./scripts/registry-consumer-probe.mjs",
    "verify:ci": "node ./scripts/verify-ci.mjs",
    "biome": "biome",
    "knip": "knip",
    "knip:report": "knip --reporter compact"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@weaver/config-engine": "link:@weaver/config-engine",
    "@weaver/config-policy": "link:@weaver/config-policy",
    "@weaver/config-types": "link:@weaver/config-types",
    "concurrently": "^9.2.1",
    "happy-dom": "20.9.0",
    "knip": "6.8.0",
    "semver": "6.3.1",
    "tsup": "8.5.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "4.1.5",
    "yaml": "2.9.0"
  }
}
