{
  "name": "@ghost-shell/config-plugin-runtime",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": null
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:dist": "tsup"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ghost-shell/contracts": "workspace:*",
    "@weaver/config-engine": "link:@weaver/config-engine",
    "@weaver/config-types": "link:@weaver/config-types"
  }
}
